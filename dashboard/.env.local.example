# Copie este arquivo para .env.local e preencha com as credenciais do projeto Supabase.
# .env.local nunca deve ser commitado (já está no .gitignore).
#
# Ambas as variáveis abaixo usam o prefixo NEXT_PUBLIC_ porque o dashboard lê
# os dados diretamente do client (browser), sem backend intermediário — ver
# docs/README.md, seção "Arquitetura de dados e segurança".
#
# NUNCA adicione SUPABASE_SERVICE_ROLE_KEY ou DATABASE_URL aqui: essas chaves
# têm privilégios elevados e não devem existir em nenhuma variável NEXT_PUBLIC_*
# nem em código que roda no navegador.

NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
